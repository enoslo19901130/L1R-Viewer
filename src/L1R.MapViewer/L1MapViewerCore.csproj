<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType Condition="$([MSBuild]::IsOSPlatform('Windows'))">WinExe</OutputType>
        <OutputType Condition="!$([MSBuild]::IsOSPlatform('Windows'))">Exe</OutputType>
        <!-- Set UseGtk default BEFORE TargetFramework conditions that depend on it -->
        <UseGtk Condition="'$(UseGtk)' == ''">false</UseGtk>
        <!-- Use Windows TFM on Windows for WPF support, macOS TFM for native macOS builds, plain net10.0 otherwise -->
        <TargetFramework Condition="$([MSBuild]::IsOSPlatform('Windows'))">net10.0-windows</TargetFramework>
        <!-- macOS native build (UseGtk=false): use net10.0-macos to compile Objective-C bridge into executable -->
        <TargetFramework Condition="$([MSBuild]::IsOSPlatform('OSX')) AND '$(UseGtk)' != 'true'">net10.0-macos</TargetFramework>
        <!-- macOS GTK build (UseGtk=true, default) or Linux: use plain net10.0 -->
        <TargetFramework Condition="$([MSBuild]::IsOSPlatform('Linux')) OR ($([MSBuild]::IsOSPlatform('OSX')) AND '$(UseGtk)' == 'true')">net10.0</TargetFramework>
        <UseWPF Condition="$([MSBuild]::IsOSPlatform('Windows'))">true</UseWPF>
        <!-- Define WINDOWS for conditional compilation -->
        <DefineConstants Condition="$([MSBuild]::IsOSPlatform('Windows'))">$(DefineConstants);WINDOWS</DefineConstants>
        <DefineConstants Condition="$([MSBuild]::IsOSPlatform('OSX')) AND '$(UseGtk)' != 'true'">$(DefineConstants);MACOS_NATIVE</DefineConstants>
        <!-- Define SKIA_LEGACY for Win7 build with SkiaSharp 2.88 -->
        <DefineConstants Condition="'$(SkiaLegacy)' == 'true'">$(DefineConstants);SKIA_LEGACY</DefineConstants>
        <!-- Allow running on newer .NET versions if net8.0 runtime isn't available -->
        <RollForward>Major</RollForward>
        <!-- RuntimeIdentifiers required by Eto.Platform.macOS -->
        <RuntimeIdentifiers Condition="$([MSBuild]::IsOSPlatform('OSX'))">osx-x64;osx-arm64</RuntimeIdentifiers>
        <!-- Use workloads when available, otherwise fall back to manual reference -->
        <UseWorkloads Condition="'$(UseWorkloads)' == ''">false</UseWorkloads>
        <!-- Set UseGtk=true to use GTK instead of native macOS platform -->
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <ApplicationIcon>icon.ico</ApplicationIcon>
        <!-- 抑制部分 nullable 和過時 API 警告 -->
        <NoWarn>CS8600;CS8601;CS8602;CS8603;CS8604;CS8605;CS8618;CS8619;CS8622;CS8625;CS0162;CS0168;CS0169;CS0219;CS0414;CA2022;SYSLIB0021</NoWarn>

        <!-- macOS bundle identifier (required by net10.0-macos TFM) -->
        <ApplicationId Condition="$([MSBuild]::IsOSPlatform('OSX')) AND '$(UseGtk)' != 'true'">com.flyworld.l1mapviewer</ApplicationId>

        <!-- 公司與產品資訊 -->
        <Company>L1R-Viewer</Company>
        <Product>L1R-Viewer</Product>
        <Copyright>Copyright © 2026</Copyright>
        <Authors>L1R-Viewer</Authors>
        <Description>L1R-Viewer MapViewer — Lineage Remastered map viewer (read-first)</Description>
        <AssemblyName>L1R-MapViewer</AssemblyName>

        <!-- 版本號設定 (可透過 /p:Version=1.yy.MMddHHmm 覆蓋) -->
        <Version>1.0.0</Version>
        <!-- 避免與 AssemblyInfo.cs 衝突，只生成版本相關屬性 -->
        <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
        <GenerateAssemblyVersionAttribute>true</GenerateAssemblyVersionAttribute>
        <GenerateAssemblyFileVersionAttribute>true</GenerateAssemblyFileVersionAttribute>
        <GenerateAssemblyInformationalVersionAttribute>true</GenerateAssemblyInformationalVersionAttribute>
    </PropertyGroup>

    <ItemGroup>
      <!-- Cross-platform UI framework -->
      <PackageReference Include="Eto.Forms" Version="2.10.2" />
      <!-- GTK works on both Linux and macOS (as a fallback when macOS workload isn't available) -->
      <!-- On macOS, GTK is only included when UseGtk=true (default). Set UseGtk=false to use native macOS platform only -->
      <PackageReference Include="Eto.Platform.Gtk" Version="2.10.2" Condition="$([MSBuild]::IsOSPlatform('Linux')) OR ($([MSBuild]::IsOSPlatform('OSX')) AND '$(UseGtk)' == 'true')" />
      <!-- On macOS, reference the platform package for NuGet restore but assets come from manual copy -->
      <PackageReference Include="Eto.Platform.macOS" Version="2.10.2" Condition="$([MSBuild]::IsOSPlatform('OSX'))" GeneratePathProperty="true" />
      <PackageReference Include="Eto.Platform.Wpf" Version="2.10.2" Condition="$([MSBuild]::IsOSPlatform('Windows'))" />
      <PackageReference Include="NLog" Version="6.0.7" />

      <!-- SkiaSharp: 預設使用 3.x (Win10+)，傳入 /p:SkiaLegacy=true 使用 2.88 (Win7) -->
      <PackageReference Include="SkiaSharp" Version="3.119.1" Condition="'$(SkiaLegacy)' != 'true'" />
      <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="3.119.1" Condition="'$(SkiaLegacy)' != 'true' AND $([MSBuild]::IsOSPlatform('Linux'))" />
      <PackageReference Include="SkiaSharp.NativeAssets.macOS" Version="3.119.1" Condition="'$(SkiaLegacy)' != 'true' AND $([MSBuild]::IsOSPlatform('OSX'))" />
      <PackageReference Include="Eto.SkiaDraw" Version="0.2.0" Condition="'$(SkiaLegacy)' != 'true'" />

      <PackageReference Include="SkiaSharp" Version="2.88.9" Condition="'$(SkiaLegacy)' == 'true'" />
      <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="2.88.9" Condition="'$(SkiaLegacy)' == 'true' AND $([MSBuild]::IsOSPlatform('Linux'))" />
      <PackageReference Include="SkiaSharp.NativeAssets.macOS" Version="2.88.9" Condition="'$(SkiaLegacy)' == 'true' AND $([MSBuild]::IsOSPlatform('OSX'))" />

      <!-- Existing dependencies -->
      <!-- Lin.Helper.Core: in-repo ProjectReference (was PackageReference 1.5.4) to unify on a single source -->
      <ProjectReference Include="..\Lin.Helper.Core\Lin.Helper.Core.csproj" />
      <ProjectReference Include="..\L1R.Shared\L1R.Shared.csproj" />
      <PackageReference Include="System.Text.Encoding.CodePages" Version="9.0.0" />
      <!-- Settings support for non-Windows platforms -->
      <PackageReference Include="System.Configuration.ConfigurationManager" Version="9.0.0" Condition="!$([MSBuild]::IsOSPlatform('Windows'))" />
    </ItemGroup>

    <!-- NLog 配置檔複製到輸出目錄 -->
    <ItemGroup>
      <None Include="nlog.config" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <!-- 排除 tests 資料夾不發布 -->
    <ItemGroup>
      <Content Remove="tests\**" />
      <Content Include="tests\assets\8100\7fff8000.s32" />
      <None Remove="tests\**" />
      <Compile Remove="tests\**" />
    </ItemGroup>

    <!-- macOS/Linux: Copy platform assemblies from NuGet cache since TFM doesn't match -->
    <Target Name="CopyEtoPlatformAssemblies" AfterTargets="Build" Condition="$([MSBuild]::IsOSPlatform('OSX')) OR $([MSBuild]::IsOSPlatform('Linux'))">
      <PropertyGroup>
        <!-- Eto packages may not have net10.0 yet, fallback to net8.0 assemblies -->
        <EtoMacOSSource>$(NuGetPackageRoot)eto.platform.macos/2.10.2/lib/net8.0-macos14.0/Eto.macOS.dll</EtoMacOSSource>
        <EtoGtkSource>$(NuGetPackageRoot)eto.platform.gtk/2.10.2/lib/net6.0/Eto.Gtk.dll</EtoGtkSource>
      </PropertyGroup>
      <Copy SourceFiles="$(EtoMacOSSource)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" Condition="$([MSBuild]::IsOSPlatform('OSX')) AND Exists('$(EtoMacOSSource)')" />
      <!-- Only copy GTK on macOS if UseGtk is true -->
      <Copy SourceFiles="$(EtoGtkSource)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" Condition="'$(UseGtk)' == 'true' AND Exists('$(EtoGtkSource)')" />
      <Message Text="Copied Eto.macOS.dll to $(OutputPath)" Importance="high" Condition="$([MSBuild]::IsOSPlatform('OSX')) AND Exists('$(EtoMacOSSource)')" />
      <Message Text="Copied Eto.Gtk.dll to $(OutputPath)" Importance="high" Condition="'$(UseGtk)' == 'true' AND Exists('$(EtoGtkSource)')" />
    </Target>

    <!-- Fix .NET 10 macOS workload bug: MonoBundleExecutable in Info.plist says .exe but actual file is .dll -->
    <Target Name="FixMonoBundleExecutable" AfterTargets="Publish" Condition="$([MSBuild]::IsOSPlatform('OSX')) AND '$(UseGtk)' != 'true'">
      <Exec Command="/usr/libexec/PlistBuddy -c 'Set :MonoBundleExecutable L1MapViewerCore.dll' '$(PublishDir)../L1MapViewerCore.app/Contents/Info.plist' || /usr/libexec/PlistBuddy -c 'Add :MonoBundleExecutable string L1MapViewerCore.dll' '$(PublishDir)../L1MapViewerCore.app/Contents/Info.plist'" IgnoreExitCode="true" />
    </Target>

    <!--
      macOS native build post-build fixes:
      1. MonoBundleExecutable workload bug (.exe → .dll)
      2. SkiaSharp single-arch slice → universal binary
      3. Re-sign all dylibs + bundle with JIT entitlements
      Runs after the macOS workload finishes creating the app bundle.
      Windows/Linux builds are not affected (Condition guards).
    -->
    <Target Name="FixMacOSNativeBuild" AfterTargets="_CreateMergedAppBundle;Build" Condition="$([MSBuild]::IsOSPlatform('OSX')) AND '$(UseGtk)' != 'true'">
      <PropertyGroup>
        <_AppBundle>$([System.IO.Path]::Combine('$(OutputPath)','L1MapViewerCore.app'))</_AppBundle>
        <_MonoBundle>$(_AppBundle)/Contents/MonoBundle</_MonoBundle>
        <_InfoPlist>$(_AppBundle)/Contents/Info.plist</_InfoPlist>
        <_SkiaUniversal>$(NuGetPackageRoot)skiasharp.nativeassets.macos/3.119.1/runtimes/osx/native/libSkiaSharp.dylib</_SkiaUniversal>
        <_Entitlements>$(MSBuildProjectDirectory)/macOS/entitlements.plist</_Entitlements>
      </PropertyGroup>

      <!-- 1. Fix MonoBundleExecutable (.exe → .dll) -->
      <Message Text="[FixMacOS] Fixing Info.plist at $(_InfoPlist)" Importance="high" />
      <Exec Command="/usr/libexec/PlistBuddy -c 'Set :MonoBundleExecutable L1MapViewerCore.dll' '$(_InfoPlist)' || /usr/libexec/PlistBuddy -c 'Add :MonoBundleExecutable string L1MapViewerCore.dll' '$(_InfoPlist)'" Condition="Exists('$(_InfoPlist)')" />

      <!-- 2. Replace SkiaSharp with universal binary (build extracts single-arch slice) -->
      <Copy SourceFiles="$(_SkiaUniversal)" DestinationFiles="$(_MonoBundle)/libSkiaSharp.dylib" OverwriteReadOnlyFiles="true" Condition="Exists('$(_SkiaUniversal)') AND Exists('$(_MonoBundle)')" />
      <Message Text="[FixMacOS] Replaced libSkiaSharp.dylib with universal binary" Importance="high" Condition="Exists('$(_SkiaUniversal)')" />

      <!-- 3. Re-sign all dylibs then executable then bundle -->
      <Exec Command="find '$(_MonoBundle)' -name '*.dylib' -exec codesign --force -s - {} \%3B" Condition="Exists('$(_MonoBundle)')" />
      <Exec Command="codesign --force -s - --entitlements '$(_Entitlements)' '$(_AppBundle)/Contents/MacOS/L1MapViewerCore'" Condition="Exists('$(_AppBundle)/Contents/MacOS/L1MapViewerCore') AND Exists('$(_Entitlements)')" />
      <Exec Command="codesign --force -s - --entitlements '$(_Entitlements)' '$(_AppBundle)'" Condition="Exists('$(_AppBundle)') AND Exists('$(_Entitlements)')" />
      <Message Text="[FixMacOS] Re-signed macOS app bundle with JIT entitlements" Importance="high" />
    </Target>

    <!-- Also copy during Publish for self-contained deployments -->
    <Target Name="CopyEtoPlatformAssembliesPublish" AfterTargets="Publish" Condition="$([MSBuild]::IsOSPlatform('OSX')) OR $([MSBuild]::IsOSPlatform('Linux'))">
      <PropertyGroup>
        <EtoMacOSSource>$(NuGetPackageRoot)eto.platform.macos/2.10.2/lib/net8.0-macos14.0/Eto.macOS.dll</EtoMacOSSource>
        <EtoGtkSource>$(NuGetPackageRoot)eto.platform.gtk/2.10.2/lib/net6.0/Eto.Gtk.dll</EtoGtkSource>
      </PropertyGroup>
      <Copy SourceFiles="$(EtoMacOSSource)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" Condition="$([MSBuild]::IsOSPlatform('OSX')) AND Exists('$(EtoMacOSSource)')" />
      <!-- Only copy GTK on macOS if UseGtk is true -->
      <Copy SourceFiles="$(EtoGtkSource)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" Condition="'$(UseGtk)' == 'true' AND Exists('$(EtoGtkSource)')" />
      <Message Text="Copied Eto.macOS.dll to $(PublishDir)" Importance="high" Condition="$([MSBuild]::IsOSPlatform('OSX')) AND Exists('$(EtoMacOSSource)')" />
      <Message Text="Copied Eto.Gtk.dll to $(PublishDir)" Importance="high" Condition="'$(UseGtk)' == 'true' AND Exists('$(EtoGtkSource)')" />
      <!-- Remove Eto.Gtk.dll from publish output if UseGtk is false -->
      <Delete Files="$(PublishDir)Eto.Gtk.dll" Condition="'$(UseGtk)' == 'false' AND Exists('$(PublishDir)Eto.Gtk.dll')" />
      <Message Text="Removed Eto.Gtk.dll from $(PublishDir) (UseGtk=false)" Importance="high" Condition="'$(UseGtk)' == 'false'" />
    </Target>

</Project>
